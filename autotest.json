// pz-autotest configuration of Food Expiry (.claude/tools/pz-autotest/README.md), commands in
// docs/annexes/tests/autotest.md:
//   python .claude/tools/pz-autotest/pz_autotest.py check ErisFoodExpiry
//   python .claude/tools/pz-autotest/pz_autotest.py sp    ErisFoodExpiry --wait-idle 3600
//   python .claude/tools/pz-autotest/pz_autotest.py mp    ErisFoodExpiry --wait-idle 3600
{
  "name": "ErisFoodExpiry",
  "gameVersion": "42.21",
  // Load order: the require= of mod.info (TooltipLib) first. TooltipLib is only READ from the Steam Workshop
  // folder 108600 and copied into the test cache.
  "mods": [
    {"workshop": "3694097672", "id": "TooltipLib"},
    {"path": "Contents/mods/batman_ErisFoodExpiry"}
  ],
  // Client hooks only: the mod is display only (media/lua/client). They create fresh, chilled and frozen food,
  // read the lines of the mod's TooltipLib provider and age the food with the engine (Food.updateAge).
  "hooks": "autotest/efe_hooks.lua",
  "params": {},
  "sp": {
    // Any Sandbox save works (the mod list of the copy is replaced); the most recent match is copied.
    "save": "2026-10-17_17-50-04",
    "gameMode": "Sandbox",
    "saveMods": "replace",
    "timeoutSec": 600,
    "startDelaySec": 5
  },
  "mp": {
    "serverName": "pzat_efe_mp",
    "port": 17401,
    // Medium house of Muldraugh (media/maps/Muldraugh, KY/spawnpoints.lua): fixed spawn, no spawn choice screen.
    "spawn": "10656,10137,0",
    "clients": 1,
    "clientXmx": "3072m",
    // The test runs on client 1 (what the player sees in multiplayer); the server only hosts.
    "serverRun": false,
    "clientRun": true,
    "timeoutSec": 1800,
    "joinTimeoutSec": 600,
    "ini": {"Map": "Muldraugh, KY", "MaxPlayers": 4}
  }
}
